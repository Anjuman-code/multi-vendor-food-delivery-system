NODE_ENV=development
PORT=2002

MONGODB_URI=mongodb://localhost:27017/food-delivery

JWT_ACCESS_SECRET=your-access-token-secret-key-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-token-secret-key-min-32-chars-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Transactional Email Pipeline (Food Rush)
EMAIL_MODE=sandbox # 'sandbox' writes previews to .email-previews/, 'smtp' sends via real SMTP
EMAIL_FROM_NAME=Food Rush
EMAIL_FROM_ADDRESS=no-reply@foodrush.com
EMAIL_REPLY_TO=support@foodrush.com
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
UNSUBSCRIBE_JWT_SECRET=your-unsubscribe-hmac-secret-min-32-chars
EMAIL_PAYLOAD_SECRET=your-outbox-aes-256-payload-secret-min-32-chars
ADMIN_EMAIL=admin@foodrush.com

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=15
PASSWORD_RESET_EXPIRY=15
EMAIL_VERIFICATION_EXPIRY=24

FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=food-delivery

# OpenStreetMap Delivery Routing & Geocoding (FOSS)
OSRM_BASE_URL=http://localhost:5000
ROUTING_TIMEOUT_MS=2000
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=FoodRush-Delivery/1.0 (contact: support@foodrush.app)
DELIVERY_QUOTE_SECRET=your-delivery-quote-signing-secret-min-32-chars
